
@model AcxiomCRM.Models.Customer

@{
    ViewData["Title"] = "Edit Customer";
}

<div class="mb-4">
    <h2 class="fw-bold">Edit Customer</h2>
    <p class="text-muted">Update customer information</p>
</div>

<div class="card shadow-sm p-4">
    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="CustomerId" />

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="CustomerName" class="form-label">Customer Name</label>
            <input asp-for="CustomerName" class="form-control" />
            <span asp-validation-for="CustomerName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Phone" class="form-label">Phone</label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CompanyName" class="form-label">Company</label>
            <input asp-for="CompanyName" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Address" class="form-label">Address</label>
            <input asp-for="Address" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="City" class="form-label">City</label>
            <input asp-for="City" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="State" class="form-label">State</label>
            <input asp-for="State" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label">Status</label>
            <select asp-for="Status" class="form-select">
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">
            Update Customer
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>
