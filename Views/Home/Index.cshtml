
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid mt-4">
    <h2 class="fw-bold">Welcome to AcxiomCRM 👋</h2>
    <p class="text-muted">Customer Relationship Management Dashboard</p>

    <div class="row mt-4">

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm p-3">
                <h6>Total Customers</h6>
                <h2 class="text-primary">120</h2>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm p-3">
                <h6>Total Leads</h6>
                <h2 class="text-success">85</h2>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm p-3">
                <h6>Opportunities</h6>
                <h2 class="text-warning">32</h2>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm p-3">
                <h6>Follow-Ups</h6>
                <h2 class="text-danger">15</h2>
            </div>
        </div>

    </div>

    <div class="card shadow-sm mt-3 p-4">
        <h4>Quick Overview</h4>
        <p>Manage your customers, leads and sales activities
            from one place.</p>
    </div>
</div>
