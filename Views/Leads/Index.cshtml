
@model IEnumerable<AcxiomCRM.Models.Lead>

@{
    ViewData["Title"] = "Leads";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold">Leads</h2>
        <p class="text-muted">Manage and track your potential customers</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        + Add Lead
    </a>
</div>

<div class="card shadow-sm p-3 mb-4">
    <form asp-action="Index" method="get" class="d-flex gap-2">
        <input type="text"
               name="searchString"
               value="@ViewData["CurrentFilter"]"
               class="form-control"
               placeholder="Search by name, email or company..." />

        <button type="submit" class="btn btn-primary">Search</button>

        <a asp-action="Index" class="btn btn-secondary">Clear</a>
    </form>
</div>

<div class="card shadow-sm p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Company</th>
                    <th>Source</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var lead in Model)
                {
                    <tr>
                        <td>@lead.LeadName</td>
                        <td>@lead.Email</td>
                        <td>@lead.Phone</td>
                        <td>@lead.CompanyName</td>
                        <td>@lead.Source</td>
                        <td>
                            <span class="badge bg-info text-dark">
                                @lead.Status
                            </span>
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-action="Edit"
                                   asp-route-id="@lead.LeadId"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@lead.LeadId"
                                      method="post"
                                      onsubmit="return confirm('Delete this lead?')">
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-danger">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <p class="text-center text-muted">
            No leads added yet.
        </p>
    }
</div>
